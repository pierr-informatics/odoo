<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend sale.order form: CPQ columns, discount field, breakdown tab -->
    <record id="sale_order_form_view_cpq" model="ir.ui.view">
        <field name="name">sale.order.form.cpq</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Proposal Notes tab -->
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Proposal Notes" name="proposal_notes">
                    <field name="custom_proposal_notes"
                           placeholder="Executive summary or custom notes for the proposal PDF..."/>
                </page>
            </xpath>

            <!-- CPQ Breakdown tab: per-module discount + quoted totals -->
            <xpath expr="//page[@name='proposal_notes']" position="after">
                <page string="CPQ Breakdown" name="cpq_breakdown">
                    <p class="text-muted" style="font-size:12px;">
                        Enter the <strong>List Price Discount (%)</strong> for each CPQ module.
                        The system will show an error if the quoted price falls below the dealer price.
                    </p>
                    <field name="order_line" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id" string="Module" readonly="1" optional="show"/>
                            <field name="product_uom_qty" string="Beds" readonly="1" optional="show"/>
                            <field name="computed_total_mrp" string="Total List Price" readonly="1" optional="show"/>
                            <field name="mrp_discount" string="Discount (%)" optional="show"/>
                            <field name="quoted_total" string="Quoted Total" readonly="1" optional="show"/>
                            <field name="quoted_price_per_bed" string="Quoted / Bed" readonly="1" optional="show"/>
                            <field name="blended_avg_price" string="Dealer Price / Bed" readonly="1" optional="show"/>
                        </list>
                    </field>
                    <!-- Breakdown HTML section -->
                    <div class="mt-3">
                        <field name="order_line" nolabel="1" readonly="1">
                            <list>
                                <field name="bracket_breakdown_html" string="Breakdown" widget="html" optional="show"/>
                            </list>
                        </field>
                    </div>
                </page>
            </xpath>

            <!-- Add mrp_discount + CPQ columns to the main SO line list -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal'][last()]" position="after">
                <field name="mrp_discount" string="List Disc.%" optional="show"/>
                <field name="computed_total_sale" string="Dealer Total" optional="hide"/>
                <field name="computed_total_mrp" string="List Total" optional="show"/>
                <field name="quoted_total" string="Quoted Total" optional="show"/>
                <field name="quoted_price_per_bed" string="Quoted/Bed" optional="hide"/>
                <field name="computed_total_transfer_price" string="Base Cost Total"
                       groups="datamate_crm.group_datamate_sales" optional="hide"/>
                <field name="blended_avg_price" string="Dealer Price/Bed" optional="hide"/>
            </xpath>

        </field>
    </record>

</odoo>

