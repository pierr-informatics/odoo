<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Override the sale order PDF report to inject CPQ content -->
    <template id="report_saleorder_document_cpq" inherit_id="sale.report_saleorder_document">

        <!-- CPQ grouped quote layout — replaces standard order-lines table -->
        <xpath expr="//table[hasclass('o_main_table')]" position="replace">

            <!-- Executive Summary -->
            <div t-if="doc.custom_proposal_notes" class="mb-4">
                <h5 style="color:#1a2e6e; border-bottom:2px solid #1a2e6e; padding-bottom:4px; margin-bottom:8px;"><strong>Executive Summary</strong></h5>
                <div t-field="doc.custom_proposal_notes"/>
            </div>

            <!-- Build CPQ line sets -->
            <t t-set="all_cpq" t-value="doc.order_line.filtered(lambda l: l.product_id and l.product_id.product_tmpl_id.cpq_type == 'module')"/>
            <t t-set="main_products" t-value="all_cpq.mapped('product_id.product_tmpl_id.main_product_id').filtered('id')"/>

            <!-- One section per Main Product -->
            <t t-foreach="main_products" t-as="mp">
                <t t-set="mp_lines" t-value="all_cpq.filtered(lambda l: l.product_id.product_tmpl_id.main_product_id.id == mp.id)"/>
                <t t-set="mp_subtotal" t-value="sum(ml.quoted_total or 0.0 for ml in mp_lines)"/>

                <!-- Main Product header bar -->
                <div class="mt-4" style="background:#1a2e6e; color:#fff; padding:8px 14px; border-radius:3px 3px 0 0;">
                    <strong style="font-size:13px; color:#fff; letter-spacing:0.4px;" t-out="mp.name">Main Product</strong>
                </div>

                <!-- Module summary table -->
                <table class="table table-sm table-bordered mb-0" style="font-size:12px; border-top:none; margin-top:0;">
                    <thead style="background:#dce4f5;">
                        <tr>
                            <th style="width:28%;">Module</th>
                            <th class="text-end" style="width:7%;">Beds</th>
                            <th class="text-end" style="width:13%;">Dealer Avg / Bed</th>
                            <th class="text-end" style="width:13%;">List Total</th>
                            <th class="text-end" style="width:9%;">Disc. %</th>
                            <th class="text-end" style="width:13%;">Quoted / Bed</th>
                            <th class="text-end" style="width:13%;">Quoted Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="mp_lines" t-as="ml">
                            <tr>
                                <td><strong t-out="ml.product_id.name">Module</strong></td>
                                <td class="text-end"><t t-out="int(ml.product_uom_qty)">0</t></td>
                                <td class="text-end"><t t-out="'%.2f' % (ml.blended_avg_price or 0.0)">0.00</t></td>
                                <td class="text-end"><t t-out="'%.2f' % (ml.computed_total_mrp or 0.0)">0.00</t></td>
                                <td class="text-end"><t t-out="'%.1f' % (ml.mrp_discount or 0.0)">0.0</t>%</td>
                                <td class="text-end"><t t-out="'%.2f' % (ml.quoted_price_per_bed or 0.0)">0.00</t></td>
                                <td class="text-end fw-bold"><t t-out="'%.2f' % (ml.quoted_total or 0.0)">0.00</t></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot style="background:#dce4f5;">
                        <tr>
                            <td colspan="6" class="text-end fw-bold" style="color:#1a2e6e;">Sub-Total &#8212; <t t-out="mp.name">MP</t></td>
                            <td class="text-end fw-bold" style="color:#1a2e6e;"><t t-out="doc.currency_id.symbol">$</t>&#160;<t t-out="'%.2f' % mp_subtotal">0.00</t></td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Per-module tier breakdown + notes + T&C -->
                <t t-foreach="mp_lines" t-as="ml">
                    <t t-set="ml_tmpl" t-value="ml.product_id.product_tmpl_id"/>
                    <t t-set="ml_tiers" t-value="ml_tmpl.pricing_tier_ids.sorted('sequence')"/>
                    <div class="mt-3 mb-1" style="margin-left:14px;">

                        <!-- Module sub-header -->
                        <div style="background:#f0f4ff; border-left:4px solid #1a2e6e; padding:5px 10px; margin-bottom:6px;">
                            <strong style="color:#1a2e6e; font-size:12px;">
                                <t t-out="ml_tmpl.name">Module</t> &#160;&#8212;&#160; Tier Breakdown (<t t-out="int(ml.product_uom_qty)">0</t> Beds)
                            </strong>
                        </div>

                        <!-- Tier breakdown table -->
                        <table class="table table-sm table-bordered" style="font-size:11px; max-width:540px;">
                            <thead style="background:#f8f9fc;">
                                <tr>
                                    <th class="text-end" style="width:12%;">From</th>
                                    <th class="text-end" style="width:12%;">To</th>
                                    <th class="text-end" style="width:28%;">List Price / Bed</th>
                                    <th class="text-end" style="width:12%;">Beds</th>
                                    <th class="text-end" style="width:24%;">List Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="bk_cursor" t-value="1"/>
                                <t t-set="bk_remaining" t-value="ml.product_uom_qty"/>
                                <t t-foreach="ml_tiers" t-as="bk">
                                    <t t-if="bk_remaining &gt; 0">
                                        <t t-if="bk_last or bk.bracket_size &lt;= 0">
                                            <t t-set="bk_beds" t-value="bk_remaining"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="bk_beds" t-value="min(bk_remaining, bk.bracket_size)"/>
                                        </t>
                                        <tr>
                                            <td class="text-end"><t t-out="int(bk_cursor)">0</t></td>
                                            <td class="text-end"><t t-out="int(bk_cursor + bk_beds - 1)">0</t></td>
                                            <td class="text-end"><t t-out="'%.2f' % bk.mrp">0.00</t></td>
                                            <td class="text-end"><t t-out="int(bk_beds)">0</t></td>
                                            <td class="text-end"><t t-out="'%.2f' % (bk_beds * bk.mrp)">0.00</t></td>
                                        </tr>
                                        <t t-set="bk_cursor" t-value="bk_cursor + bk_beds"/>
                                        <t t-set="bk_remaining" t-value="bk_remaining - bk_beds"/>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-end fw-bold">Total List Price</td>
                                    <td class="text-end fw-bold"><t t-out="'%.2f' % (ml.computed_total_mrp or 0.0)">0.00</t></td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text-end" style="color:#777;">Discount (<t t-out="'%.1f' % (ml.mrp_discount or 0.0)">0.0</t>%)</td>
                                    <td class="text-end" style="color:#777;">&#8722;&#160;<t t-out="'%.2f' % ((ml.computed_total_mrp or 0.0) - (ml.quoted_total or 0.0))">0.00</t></td>
                                </tr>
                                <tr style="background:#f0f4ff;">
                                    <td colspan="4" class="text-end fw-bold" style="color:#1a2e6e;">Quoted Total</td>
                                    <td class="text-end fw-bold" style="color:#1a2e6e;"><t t-out="'%.2f' % (ml.quoted_total or 0.0)">0.00</t></td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text-end" style="color:#1a2e6e;">Quoted Price / Bed</td>
                                    <td class="text-end" style="color:#1a2e6e;"><t t-out="'%.2f' % (ml.quoted_price_per_bed or 0.0)">0.00</t></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Feature Highlights -->
                        <div t-if="not is_html_empty(ml_tmpl.preset_proposal_notes)" class="mt-2 mb-2">
                            <div style="font-weight:bold; font-size:11px; color:#222; border-bottom:1px solid #dce4f5; padding-bottom:2px; margin-bottom:4px;">Feature Highlights</div>
                            <div t-field="ml_tmpl.preset_proposal_notes" style="font-size:11px;"/>
                        </div>

                        <!-- Terms and Conditions -->
                        <div t-if="not is_html_empty(ml_tmpl.preset_terms_conditions)" class="mt-2 mb-3">
                            <div style="font-weight:bold; font-size:11px; color:#222; border-bottom:1px solid #dce4f5; padding-bottom:2px; margin-bottom:4px;">Terms &amp; Conditions</div>
                            <div t-field="ml_tmpl.preset_terms_conditions" style="font-size:11px;"/>
                        </div>

                    </div>
                </t>

            </t>

            <!-- Fallback: CPQ modules with no main product assigned -->
            <t t-set="no_mp_lines" t-value="all_cpq.filtered(lambda l: not l.product_id.product_tmpl_id.main_product_id)"/>
            <t t-if="no_mp_lines">
                <div class="mt-4" style="background:#555; color:#fff; padding:8px 14px; border-radius:3px 3px 0 0;">
                    <strong style="font-size:13px; color:#fff;">Other Modules</strong>
                </div>
                <table class="table table-sm table-bordered mb-2" style="font-size:12px;">
                    <thead style="background:#e8e8e8;">
                        <tr>
                            <th>Module</th>
                            <th class="text-end">Beds</th>
                            <th class="text-end">Dealer Avg / Bed</th>
                            <th class="text-end">List Total</th>
                            <th class="text-end">Disc. %</th>
                            <th class="text-end">Quoted / Bed</th>
                            <th class="text-end">Quoted Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="no_mp_lines" t-as="ml">
                            <tr>
                                <td><strong t-out="ml.product_id.name">Module</strong></td>
                                <td class="text-end"><t t-out="int(ml.product_uom_qty)">0</t></td>
                                <td class="text-end"><t t-out="'%.2f' % (ml.blended_avg_price or 0.0)">0.00</t></td>
                                <td class="text-end"><t t-out="'%.2f' % (ml.computed_total_mrp or 0.0)">0.00</t></td>
                                <td class="text-end"><t t-out="'%.1f' % (ml.mrp_discount or 0.0)">0.0</t>%</td>
                                <td class="text-end"><t t-out="'%.2f' % (ml.quoted_price_per_bed or 0.0)">0.00</t></td>
                                <td class="text-end fw-bold"><t t-out="'%.2f' % (ml.quoted_total or 0.0)">0.00</t></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <t t-foreach="no_mp_lines" t-as="ml">
                    <t t-set="ml_tmpl" t-value="ml.product_id.product_tmpl_id"/>
                    <t t-set="ml_tiers" t-value="ml_tmpl.pricing_tier_ids.sorted('sequence')"/>
                    <div class="mt-2 mb-2" style="margin-left:14px;">
                        <div style="background:#f5f5f5; border-left:4px solid #555; padding:5px 10px; margin-bottom:6px;">
                            <strong style="font-size:12px;"><t t-out="ml_tmpl.name">Module</t> &#8212; Tier Breakdown (<t t-out="int(ml.product_uom_qty)">0</t> Beds)</strong>
                        </div>
                        <table class="table table-sm table-bordered" style="font-size:11px; max-width:540px;">
                            <thead style="background:#f8f8f8;">
                                <tr>
                                    <th class="text-end">From</th>
                                    <th class="text-end">To</th>
                                    <th class="text-end">List Price / Bed</th>
                                    <th class="text-end">Beds</th>
                                    <th class="text-end">List Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="bk_cursor" t-value="1"/>
                                <t t-set="bk_remaining" t-value="ml.product_uom_qty"/>
                                <t t-foreach="ml_tiers" t-as="bk">
                                    <t t-if="bk_remaining &gt; 0">
                                        <t t-if="bk_last or bk.bracket_size &lt;= 0">
                                            <t t-set="bk_beds" t-value="bk_remaining"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="bk_beds" t-value="min(bk_remaining, bk.bracket_size)"/>
                                        </t>
                                        <tr>
                                            <td class="text-end"><t t-out="int(bk_cursor)">0</t></td>
                                            <td class="text-end"><t t-out="int(bk_cursor + bk_beds - 1)">0</t></td>
                                            <td class="text-end"><t t-out="'%.2f' % bk.mrp">0.00</t></td>
                                            <td class="text-end"><t t-out="int(bk_beds)">0</t></td>
                                            <td class="text-end"><t t-out="'%.2f' % (bk_beds * bk.mrp)">0.00</t></td>
                                        </tr>
                                        <t t-set="bk_cursor" t-value="bk_cursor + bk_beds"/>
                                        <t t-set="bk_remaining" t-value="bk_remaining - bk_beds"/>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-end fw-bold">Total List Price</td>
                                    <td class="text-end fw-bold"><t t-out="'%.2f' % (ml.computed_total_mrp or 0.0)">0.00</t></td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text-end" style="color:#777;">Discount (<t t-out="'%.1f' % (ml.mrp_discount or 0.0)">0.0</t>%)</td>
                                    <td class="text-end" style="color:#777;">&#8722;&#160;<t t-out="'%.2f' % ((ml.computed_total_mrp or 0.0) - (ml.quoted_total or 0.0))">0.00</t></td>
                                </tr>
                                <tr style="background:#f0f4ff;">
                                    <td colspan="4" class="text-end fw-bold" style="color:#1a2e6e;">Quoted Total</td>
                                    <td class="text-end fw-bold" style="color:#1a2e6e;"><t t-out="'%.2f' % (ml.quoted_total or 0.0)">0.00</t></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div t-if="not is_html_empty(ml_tmpl.preset_proposal_notes)" class="mt-2 mb-2">
                            <div style="font-weight:bold; font-size:11px; margin-bottom:3px;">Feature Highlights</div>
                            <div t-field="ml_tmpl.preset_proposal_notes" style="font-size:11px;"/>
                        </div>
                        <div t-if="not is_html_empty(ml_tmpl.preset_terms_conditions)" class="mt-2 mb-3">
                            <div style="font-weight:bold; font-size:11px; margin-bottom:3px;">Terms &amp; Conditions</div>
                            <div t-field="ml_tmpl.preset_terms_conditions" style="font-size:11px;"/>
                        </div>
                    </div>
                </t>
            </t>

        </xpath>

        <!-- Replace standard dealer-price totals with Quoted Grand Total -->
        <xpath expr="//div[@name='so_total_summary']" position="replace">
            <div class="clearfix" name="so_total_summary">
                <t t-set="grand_cpq" t-value="doc.order_line.filtered(lambda l: l.product_id and l.product_id.product_tmpl_id.cpq_type == 'module')"/>
                <t t-set="grand_total_quoted" t-value="sum(l.quoted_total or 0.0 for l in grand_cpq)"/>
                <t t-set="main_products_gt" t-value="grand_cpq.mapped('product_id.product_tmpl_id.main_product_id').filtered('id')"/>
                <div class="row justify-content-end mt-3">
                    <div class="col-5">
                        <table class="table table-sm table-borderless" style="font-size:12px;">
                            <t t-foreach="main_products_gt" t-as="mpgt">
                                <t t-set="mpgt_lines" t-value="grand_cpq.filtered(lambda l: l.product_id.product_tmpl_id.main_product_id.id == mpgt.id)"/>
                                <tr>
                                    <td style="color:#555;"><t t-out="mpgt.name">MP</t></td>
                                    <td class="text-end" style="color:#555;"><t t-out="doc.currency_id.symbol">$</t>&#160;<t t-out="'%.2f' % sum(l.quoted_total or 0.0 for l in mpgt_lines)">0.00</t></td>
                                </tr>
                            </t>
                            <tr><td colspan="2"><hr style="margin:4px 0;"/></td></tr>
                            <tr style="background:#1a2e6e;">
                                <td style="color:#fff; font-weight:bold; font-size:13px; padding:8px 10px;">Grand Total</td>
                                <td class="text-end" style="color:#fff; font-weight:bold; font-size:13px; padding:8px 10px;"><t t-out="doc.currency_id.symbol">$</t>&#160;<t t-out="'%.2f' % grand_total_quoted">0.00</t></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Footer note -->
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <div class="mt-4" style="font-size:0.85em; color:#444; border-top:1px solid #ccc; padding-top:8px;">
                <p><strong>Note:</strong> Sale price includes Sales and Distribution cost [30%]. AMC 20% (optional). If AMC is not taken, updates and support will be provided strictly on an on-call chargeable basis.</p>
                <p class="text-center mt-2"><strong>Startups pitch. We deliver.</strong></p>
            </div>
        </xpath>

    </template>

</odoo>
