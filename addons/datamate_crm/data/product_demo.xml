<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==================== MAIN PRODUCT ==================== -->
        <record id="product_datamate_hospital_erp" model="product.template">
            <field name="name">Datamate Hospital ERP</field>
            <field name="type">service</field>
            <field name="cpq_type">main_product</field>
            <field name="list_price">0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>

        <!-- ==================== MODULE: Ellider AI Suite ==================== -->
        <record id="product_ellider_ai_suite" model="product.template">
            <field name="name">Ellider AI Suite</field>
            <field name="type">service</field>
            <field name="cpq_type">module</field>
            <field name="list_price">0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="preset_proposal_notes"><![CDATA[
                <ul>
                    <li>AI-powered clinical decision support</li>
                    <li>Google AI integration for diagnostics</li>
                    <li>Smart appointment scheduling</li>
                    <li>Predictive analytics dashboard</li>
                </ul>
            ]]></field>
            <field name="preset_terms_conditions"><![CDATA[
                <ul>
                    <li>Google AI processing cost not included — billed monthly based on actual usage.</li>
                    <li>Implementation timeline: 8-12 weeks from order confirmation.</li>
                    <li>Training: 5 days on-site included.</li>
                </ul>
            ]]></field>
        </record>

        <!-- Ellider AI Suite: Pricing Tiers -->
        <!-- transfer_price is the only manual input; sale_price and mrp are computed via margins -->
        <!-- sale = transfer / (1 - 0.40) = transfer / 0.60 -->
        <!-- mrp  = sale    / (1 - 0.30) = sale    / 0.70 -->
        <record id="tier_ellider_1" model="product.pricing.tier">
            <field name="product_tmpl_id" ref="product_ellider_ai_suite"/>
            <field name="sequence">10</field>
            <field name="name">First 50 Beds</field>
            <field name="bracket_size">50</field>
            <field name="transfer_price">6000</field>
            <field name="margin_sale_to_transfer">40</field>
            <field name="margin_mrp_to_sale">30</field>
        </record>
        <record id="tier_ellider_2" model="product.pricing.tier">
            <field name="product_tmpl_id" ref="product_ellider_ai_suite"/>
            <field name="sequence">20</field>
            <field name="name">Beds 51–100</field>
            <field name="bracket_size">50</field>
            <field name="transfer_price">4800</field>
            <field name="margin_sale_to_transfer">40</field>
            <field name="margin_mrp_to_sale">30</field>
        </record>
        <record id="tier_ellider_3" model="product.pricing.tier">
            <field name="product_tmpl_id" ref="product_ellider_ai_suite"/>
            <field name="sequence">30</field>
            <field name="name">Beds 101–200</field>
            <field name="bracket_size">100</field>
            <field name="transfer_price">4200</field>
            <field name="margin_sale_to_transfer">40</field>
            <field name="margin_mrp_to_sale">30</field>
        </record>
        <record id="tier_ellider_4" model="product.pricing.tier">
            <field name="product_tmpl_id" ref="product_ellider_ai_suite"/>
            <field name="sequence">40</field>
            <field name="name">Beds 201–300</field>
            <field name="bracket_size">100</field>
            <field name="transfer_price">3600</field>
            <field name="margin_sale_to_transfer">40</field>
            <field name="margin_mrp_to_sale">30</field>
        </record>
        <record id="tier_ellider_5" model="product.pricing.tier">
            <field name="product_tmpl_id" ref="product_ellider_ai_suite"/>
            <field name="sequence">50</field>
            <field name="name">Beds 301+</field>
            <field name="bracket_size">0</field>
            <field name="transfer_price">3000</field>
            <field name="margin_sale_to_transfer">40</field>
            <field name="margin_mrp_to_sale">30</field>
        </record>

        <!-- ==================== MODULE: Dental EMR ==================== -->
        <record id="product_dental_emr" model="product.template">
            <field name="name">Dental EMR</field>
            <field name="type">service</field>
            <field name="cpq_type">module</field>
            <field name="list_price">0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="preset_proposal_notes"><![CDATA[
                <ul>
                    <li>Full dental charting with OPG integration</li>
                    <li>Treatment planning and costing</li>
                    <li>Insurance claim management</li>
                </ul>
            ]]></field>
            <field name="preset_terms_conditions"><![CDATA[
                <ul>
                    <li>Implementation timeline: 4-6 weeks from order confirmation.</li>
                    <li>Training: 3 days on-site included.</li>
                </ul>
            ]]></field>
        </record>

        <!-- Dental EMR: Pricing Tiers -->
        <record id="tier_dental_1" model="product.pricing.tier">
            <field name="product_tmpl_id" ref="product_dental_emr"/>
            <field name="sequence">10</field>
            <field name="name">First 50 Beds</field>
            <field name="bracket_size">50</field>
            <field name="transfer_price">3000</field>
            <field name="margin_sale_to_transfer">40</field>
            <field name="margin_mrp_to_sale">30</field>
        </record>
        <record id="tier_dental_2" model="product.pricing.tier">
            <field name="product_tmpl_id" ref="product_dental_emr"/>
            <field name="sequence">20</field>
            <field name="name">Beds 51–100</field>
            <field name="bracket_size">50</field>
            <field name="transfer_price">2400</field>
            <field name="margin_sale_to_transfer">40</field>
            <field name="margin_mrp_to_sale">30</field>
        </record>
        <record id="tier_dental_3" model="product.pricing.tier">
            <field name="product_tmpl_id" ref="product_dental_emr"/>
            <field name="sequence">30</field>
            <field name="name">Beds 101+</field>
            <field name="bracket_size">0</field>
            <field name="transfer_price">1800</field>
            <field name="margin_sale_to_transfer">40</field>
            <field name="margin_mrp_to_sale">30</field>
        </record>

    </data>
</odoo>
